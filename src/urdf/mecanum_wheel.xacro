<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wheel Properties from Specifications -->
  <xacro:property name="wheel_mass" value="0.044" /> <!-- 44 grams -->
  <xacro:property name="wheel_radius" value="0.040" /> <!-- 80mm outer diameter -->
  <xacro:property name="wheel_width" value="0.037" /> <!-- 37mm thickness -->

  <!-- Reusable Wheel Macro -->
  <xacro:macro name="mecanum_wheel" params="prefix parent_link x_reflect y_reflect">
    
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${parent_link}"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${x_reflect * 0.15} ${y_reflect * 0.12} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <!-- Solid cylinder inertia calculations -->
        <inertia 
          ixx="0.0000226" ixy="0.0" ixz="0.0"
          iyy="0.0000352" iyz="0.0"
          izz="0.0000226"/>
      </inertial>

      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="yellow">
          <color rgba="1.0 0.8 0.0 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>

    <!-- Gazebo Properties -->
    <gazebo reference="${prefix}_wheel_link">
      <material>Gazebo/Yellow</material>
      <mu1>0.5</mu1>
      <mu2>0.5</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
    </gazebo>

  </xacro:macro>

</robot>