<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="indoor_house">

    <physics name="smooth" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
            <bounce>
              <restitution_coefficient>0</restitution_coefficient>
            </bounce>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ===== indoor layout: outer shell 12 x 9 m, two doorways, obstacles ===== -->
    <model name="wall_south">
      <static>true</static>
      <pose>1.000 -4.000 1.000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.150 0.150 2.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.150 0.150 2.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static>
      <pose>1.000 5.000 1.000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.150 0.150 2.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.150 0.150 2.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5.000 0.500 1.000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.150 9.150 2.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.150 9.150 2.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>7.000 0.500 1.000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.150 9.150 2.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.150 9.150 2.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_a_low">
      <static>true</static>
      <pose>2.000 -2.300 1.000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.150 3.550 2.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.150 3.550 2.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_a_high">
      <static>true</static>
      <pose>2.000 1.300 1.000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.150 1.550 2.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.150 1.550 2.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_b_left">
      <static>true</static>
      <pose>3.200 2.000 1.000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.550 0.150 2.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.550 0.150 2.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_b_right">
      <static>true</static>
      <pose>6.300 2.000 1.000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.550 0.150 2.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.550 0.150 2.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_c">
      <static>true</static>
      <pose>-3.250 -1.500 1.000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.650 0.150 2.000</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.650 0.150 2.000</size></box></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_1">
      <static>true</static>
      <pose>-2.500 2.000 0.300 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.500 0.500 0.600</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.500 0.500 0.600</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>0.600 -2.600 0.500 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.200</radius><length>1.000</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.200</radius><length>1.000</length></cylinder></geometry>
          <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.55 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="shelf_1">
      <static>true</static>
      <pose>4.600 -2.400 0.600 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.000 0.350 1.200</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.000 0.350 1.200</size></box></geometry>
          <material><ambient>0.4 0.45 0.55 1</ambient><diffuse>0.4 0.45 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="crate_2">
      <static>true</static>
      <pose>-3.600 -3.000 0.250 0 0 0.5000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.600 0.400 0.500</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.600 0.400 0.500</size></box></geometry>
          <material><ambient>0.6 0.45 0.3 1</ambient><diffuse>0.6 0.45 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="table_1">
      <static>true</static>
      <pose>4.500 3.600 0.375 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.200 0.700 0.750</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.200 0.700 0.750</size></box></geometry>
          <material><ambient>0.5 0.4 0.35 1</ambient><diffuse>0.5 0.4 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>-1.000 3.600 0.500 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.250</radius><length>1.000</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.250</radius><length>1.000</length></cylinder></geometry>
          <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.55 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
